Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Enabled: true
      Name: Grid
      Reference Frame: <Fixed Frame>
      Cell Size: 0.5
      Plane Cell Count: 12
      Color: 160; 160; 164
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Names: false
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.4
    - Class: rviz/Map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map
    - Class: rviz/LaserScan
      Enabled: true
      Name: LaserScan
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Size (m): 0.03
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 60; 60
    - Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Mission
      Marker Topic:
        Value: /mission_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 100
    - Class: rviz/MarkerArray
      Enabled: true
      Name: Detections
      Marker Topic:
        Value: /detection_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 100
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 3.2
      Focal Point:
        X: 1.5
        Y: 1.5
        Z: 0
      Pitch: 0.7
      Yaw: 0.7
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1500
  X: 0
  Y: 0
