<launch>
  <!-- move_base with the robot's costmap/DWA parameters, but without the
       spark_navigation velocity smoother (not present in the sim container).
       Direct /cmd_vel. map_server and AMCL are started by nav_arena.launch. -->

  <arg name="map_frame" default="map"/>
  <arg name="odom_frame" default="odom"/>
  <arg name="base_frame" default="base_footprint"/>
  <arg name="odom_topic" default="odom"/>
  <arg name="scan_topic" default="scan"/>

  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find auto_match)/config/move_base_param/costmap_common_params.yaml"
              command="load" ns="global_costmap"/>
    <rosparam file="$(find auto_match)/config/move_base_param/costmap_common_params.yaml"
              command="load" ns="local_costmap"/>
    <rosparam file="$(find auto_match)/config/move_base_param/local_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find auto_match)/config/move_base_param/global_costmap_params.yaml"
              command="load"/>
    <rosparam file="$(find auto_match)/config/move_base_param/dwa_local_planner_params.yaml"
              command="load"/>
    <rosparam file="$(find auto_match)/config/move_base_param/move_base_params.yaml"
              command="load"/>
    <rosparam file="$(find auto_match)/config/move_base_param/global_planner_params.yaml"
              command="load"/>
    <rosparam file="$(find auto_match)/config/move_base_param/navfn_global_planner_params.yaml"
              command="load"/>

    <param name="global_costmap/global_frame" value="$(arg map_frame)"/>
    <param name="global_costmap/robot_base_frame" value="$(arg base_frame)"/>
    <param name="local_costmap/global_frame" value="$(arg odom_frame)"/>
    <param name="local_costmap/robot_base_frame" value="$(arg base_frame)"/>
    <param name="DWAPlannerROS/global_frame_id" value="$(arg odom_frame)"/>

    <!-- Keep the vendor behaviour: floor objects are not in the costmap. The arm
         needs a 0.38 m stand-off from the cube cluster, which is inside the
         inflated footprint if the cubes are marked as obstacles. Walls and the
         table are in the static map; the approach path does not cross the cluster.
         If you later enable the scan layer, lower the robot radius and inflation
         or the sorting goals become unreachable. -->

    <remap from="odom" to="$(arg odom_topic)"/>
    <remap from="scan" to="$(arg scan_topic)"/>
  </node>
</launch>
