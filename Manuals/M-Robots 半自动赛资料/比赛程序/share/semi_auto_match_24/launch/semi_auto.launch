<!--semi_auto-->
<!--SPARK技术讨论与反馈群：8346256-->
<!--
  2024 半自动任务赛 · 主 launch（OpenHarmony / aarch64-musl 交叉编译适配版）

  运行环境注意：板端是 OpenHarmony，只有 /bin/sh，
  **没有 bash / stty / 终端模拟器（xterm / gnome-terminal 之类都没有）**。
  所以本文件里：

  * 物体识别节点走 RK3588 NPU 的 YOLOv5（detect_rknn.py），不再需要 TensorFlow；
  * 键盘遥控 teleop.py 是交互式的（要按 WASD），**默认不自动拉起** ——
    OpenHarmony 上没有终端模拟器，roslaunch 拉起它只会拿到 EOF 然后空转。
    请另开一个窗口手动跑：

        run rosrun semi_auto_match_24 teleop.py

  * rviz 是 GUI，板上必须经 run_gui 拉起（/bin/run_gui 实际执行的是
    `run vglrun -d /dev/dri/card0 <cmd>`，让 Qt/OpenGL 走 GPU 渲染）；
    直接起 rviz 拿不到 GL 上下文。
  * grasp.py 里的 cv2.imshow 调试窗默认关闭（板端要有 GL 上下文才画得出来），
    需要看图时用 show_debug:=true，本文件会自动给它套上 run_gui。
-->
<launch>
	<!-- Arguments -->
	<!-- 以下三个 arg 原版就声明了但本文件并不使用（原版也没有启动 SLAM），
	     为兼容调用方脚本保留，不要以为改了 slam_methods 就会换 SLAM。 -->
	<arg name="slam_methods"           default="gmapping"   doc="（兼容保留，本 launch 不启动 SLAM）"/>
	<arg name="configuration_basename" default="spark_lds_2d.lua" doc="（兼容保留，本 launch 不启动 SLAM）"/>
	<arg name="3d_sensor"              default="3i_lidar"  doc="（兼容保留，本 launch 不使用）"/>

	<arg name="lidar_type_tel"         default="ydlidar_g6" doc="lidar type [3iroboticslidar2, ydlidar_g2, ydlidar_g6]"/>
	<arg name="camera_type_tel"        default="d435"       doc="camera type [astrapro, astra, d435...]"/>
	<arg name="open_rviz"              default="true"/>

	<!-- 机械臂：swiftpro 在 build.sh 的 skiplist 里（交叉编译不过），但板端是
	     prebuilt 装好的，所以这个 include 在板上有解。没有机械臂时 start_arm:=false。 -->
	<arg name="start_arm"              default="true"/>
	<!-- 交互式键盘遥控：板上没有终端模拟器，默认不拉，请另开窗口手动跑。 -->
	<arg name="start_teleop"           default="false"/>
	<!-- grasp.py 的 cv2.imshow 调试窗（需要 GL 上下文，故默认关闭）。 -->
	<arg name="show_debug"             default="false"/>
	<!-- rviz 布局：Fixed Frame 必须用本 launch 真有的帧。
	     本 launch 不起 SLAM / map_server，所以 **没有 map 帧** ——
	     直接抄 spark_gmapping_*.rviz（map 中心）上板就是 3D 视图一片空白。
	     这份 semi_auto.rviz 以 spark_description/rviz/urdf.rviz 为底（Fixed Frame=odom），
	     带 RobotModel / LaserScan(/scan) / Image(彩色原图) / Image(/debug_image)。
	     重新生成：python3 test/gen_rviz.py odom -->
	<arg name="rviz_config"            default="$(find semi_auto_match_24)/rviz/semi_auto.rviz"/>
	<!-- 需要 cv2.imshow 时置为 run_gui；空串表示不加任何前缀。 -->
	<arg name="gui_prefix"             default=""/>

	<!--spark底盘驱动，机器人描述,底盘,相机-->
	<include file="$(find spark_bringup)/launch/driver_bringup.launch">
		<arg name="camera_type_tel"	value="$(arg camera_type_tel)"/>
		<arg name="lidar_type_tel"	value="$(arg lidar_type_tel)"/>
		<arg name="start_camera" value="true"/>
	</include>

	<!--UARM机械臂-->
	<include file="$(find swiftpro)/launch/pro_control_nomoveit.launch" if="$(arg start_arm)"/>

	<!-- 启动雷达 -->
	<include file="$(find lidar_driver_transfer)/launch/$(arg lidar_type_tel).launch">
	</include>

	<!-- rviz -->
	<group if="$(arg open_rviz)">
		<node pkg="rviz" type="rviz" name="rviz" required="true" launch-prefix="run_gui"
		      args="-d $(arg rviz_config)"/>
	</group>

	<!-- 物体识别：RK3588 NPU 上的 YOLOv5（原版是 TensorFlow SSD MobileNet）。
	     发布面与原来一致：/location（semi_auto_match_24/LocationCentre）+ /debug_image。 -->
	<node pkg="semi_auto_match_24" name="detect_rknn" type="detect_rknn.py" output="screen">
		<rosparam command="load" file="$(find semi_auto_match_24)/config/yolo/detect_rknn.yaml"/>
		<remap from="image" to="/camera/color/image_rect_color" if="$(eval arg('camera_type_tel')=='d435')"/>
		<remap from="image" to="/camera/rgb/image_raw" unless="$(eval arg('camera_type_tel')=='d435')"/>
	</node>

	<!-- Teleop（交互式，默认不拉；板上请另开窗口 run rosrun 手动跑） -->
	<node pkg="semi_auto_match_24" type="teleop.py" name="teleop" output="screen"
	      if="$(arg start_teleop)"/>

	<!-- 颜色识别 + 机械臂抓放。现场可调的两组参数走 yaml：
	     config/grasp_heights.yaml 抓取高度（三种目标共用一套）
	     config/grasp_colors.yaml  颜色阈值（水源蓝 / 红色方块的 HSV 区间）
	     改完重启本节点即可，不用重新编译。 -->
	<node pkg="semi_auto_match_24" type="grasp.py" name="grasp" output="screen"
	      launch-prefix="$(arg gui_prefix)">
		<rosparam command="load" file="$(find semi_auto_match_24)/config/grasp_heights.yaml"/>
		<rosparam command="load" file="$(find semi_auto_match_24)/config/grasp_colors.yaml"/>
		<param name="show_debug" value="$(arg show_debug)"/>
	</node>

</launch>
