<?xml version="1.0"?>
<package>
  <name>semi_auto_match_24</name>
  <version>0.0.0</version>
  <description>
    半自动任务赛 2024 版程序。OpenHarmony / aarch64-musl 交叉编译适配版：
    物体识别从 TensorFlow SSD MobileNet 换成 RK3588 NPU 上的 YOLOv5
    （librknnrt.so + ctypes 兼容层），机械臂与键盘遥控部分保持原样。
  </description>

  <maintainer email="j.xiao@todo.todo">j.xiao</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <!-- 本包自己生成 LocationCentre.msg，所以自己需要 message_generation。
       两个依赖都不在 build.sh 的 skiplist 里，可以安全地出现在
       find_package(catkin COMPONENTS ...) 中。 -->
  <build_depend>message_generation</build_depend>
  <build_depend>std_msgs</build_depend>
  <run_depend>message_runtime</run_depend>

  <!-- 运行期依赖：nodes/*.py 真正 import 的包。
       **不要新增 build.sh skiplist 里的包**（serial / darknet_ros* /
       tensorflow_object_detector / ydlidar* / astra_camera / realsense2* /
       swiftpro / *moveit_config），否则板端 import 不到。
       swiftpro 虽然在 skiplist 里，但板端是 prebuilt 装好的；grasp.py 优先用
       本工具链编出来的 spark_carry_object，取不到时才退回 swiftpro（两者
       的 position/status 字段定义逐字节一致）。 -->
  <run_depend>rospy</run_depend>
  <run_depend>rospkg</run_depend>
  <run_depend>std_msgs</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>geometry_msgs</run_depend>
  <run_depend>cv_bridge</run_depend>
  <run_depend>spark_carry_object</run_depend>

  <export>
  </export>
</package>
